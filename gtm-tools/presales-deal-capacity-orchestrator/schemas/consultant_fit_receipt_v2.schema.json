{
  "$defs": {
    "MatchComponentV2": {
      "additionalProperties": false,
      "properties": {
        "component_bp": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Component Bp",
          "type": "integer"
        },
        "component_id": {
          "enum": [
            "SKILL_SURPLUS",
            "CONTINUITY",
            "OVERLAP_SURPLUS",
            "CAPACITY_HEADROOM"
          ],
          "title": "Component Id",
          "type": "string"
        },
        "weight_bp": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Weight Bp",
          "type": "integer"
        },
        "weighted_numerator": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Weighted Numerator",
          "type": "integer"
        }
      },
      "required": [
        "component_id",
        "component_bp",
        "weight_bp",
        "weighted_numerator"
      ],
      "title": "MatchComponentV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "components": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/MatchComponentV2"
        },
        {
          "$ref": "#/$defs/MatchComponentV2"
        },
        {
          "$ref": "#/$defs/MatchComponentV2"
        },
        {
          "$ref": "#/$defs/MatchComponentV2"
        }
      ],
      "title": "Components",
      "type": "array"
    },
    "consultant_source_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Consultant Source Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deal_source_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Deal Source Id",
      "type": "string"
    },
    "eligibility_receipt_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Eligibility Receipt Id",
      "type": "string"
    },
    "fit_bp": {
      "maximum": 10000,
      "minimum": 0,
      "title": "Fit Bp",
      "type": "integer"
    },
    "fit_receipt_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Fit Receipt Id",
      "type": "string"
    },
    "mapping_profile_sha256s": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Mapping Profile Sha256S",
      "type": "array"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "priority_receipt_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Priority Receipt Id",
      "type": "string"
    },
    "rounding": {
      "const": "ROUND_HALF_EVEN",
      "title": "Rounding",
      "type": "string"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "orchestrator.consultant-fit-receipt.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_manifest_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Manifest Ids",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "policy_sha256",
    "source_manifest_ids",
    "mapping_profile_sha256s",
    "schema_version",
    "fit_receipt_id",
    "deal_source_id",
    "consultant_source_id",
    "eligibility_receipt_id",
    "priority_receipt_id",
    "components",
    "fit_bp",
    "rounding",
    "created_at"
  ],
  "title": "ConsultantFitReceiptV2",
  "type": "object"
}
