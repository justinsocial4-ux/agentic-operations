{
  "$defs": {
    "CapacityCellV2": {
      "additionalProperties": false,
      "properties": {
        "capacity_cell_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
          "title": "Capacity Cell Id",
          "type": "string"
        },
        "committed_workload_units": {
          "minimum": 0,
          "title": "Committed Workload Units",
          "type": "integer"
        },
        "demand_units": {
          "minimum": 0,
          "title": "Demand Units",
          "type": "integer"
        },
        "eligible_supply_units": {
          "minimum": 0,
          "title": "Eligible Supply Units",
          "type": "integer"
        },
        "excluded_incomplete_consultant_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
            "type": "string"
          },
          "title": "Excluded Incomplete Consultant Ids",
          "type": "array"
        },
        "free_units": {
          "minimum": 0,
          "title": "Free Units",
          "type": "integer"
        },
        "mapping_profile_sha256s": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Mapping Profile Sha256S",
          "type": "array"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "projected_utilization_bp": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Projected Utilization Bp"
        },
        "region_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
          "title": "Region Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "orchestrator.capacity-cell.v2",
          "title": "Schema Version",
          "type": "string"
        },
        "skill_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
          "title": "Skill Id",
          "type": "string"
        },
        "skill_rows_additive": {
          "const": false,
          "title": "Skill Rows Additive",
          "type": "boolean"
        },
        "source_manifest_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Manifest Ids",
          "type": "array"
        },
        "supply_state": {
          "enum": [
            "COMPLETE",
            "PARTIAL_SUPPLY_EXCLUDED"
          ],
          "title": "Supply State",
          "type": "string"
        },
        "surplus_deficit_units": {
          "title": "Surplus Deficit Units",
          "type": "integer"
        },
        "week_bucket": {
          "enum": [
            1,
            2,
            3,
            4
          ],
          "title": "Week Bucket",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "policy_sha256",
        "source_manifest_ids",
        "mapping_profile_sha256s",
        "schema_version",
        "capacity_cell_id",
        "region_id",
        "skill_id",
        "week_bucket",
        "demand_units",
        "eligible_supply_units",
        "committed_workload_units",
        "free_units",
        "surplus_deficit_units",
        "excluded_incomplete_consultant_ids",
        "supply_state",
        "skill_rows_additive"
      ],
      "title": "CapacityCellV2",
      "type": "object"
    },
    "ScenarioEffortChangeV2": {
      "additionalProperties": false,
      "properties": {
        "base_effort_units": {
          "minimum": 0,
          "title": "Base Effort Units",
          "type": "integer"
        },
        "changed_field": {
          "const": "effort_units",
          "title": "Changed Field",
          "type": "string"
        },
        "deal_source_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
          "title": "Deal Source Id",
          "type": "string"
        },
        "multiplier": {
          "const": "1.25",
          "title": "Multiplier",
          "type": "string"
        },
        "region_id": {
          "const": "EMEA",
          "title": "Region Id",
          "type": "string"
        },
        "rounding": {
          "const": "CEILING_TO_CAPACITY_UNIT",
          "title": "Rounding",
          "type": "string"
        },
        "scenario_effort_units": {
          "minimum": 0,
          "title": "Scenario Effort Units",
          "type": "integer"
        }
      },
      "required": [
        "deal_source_id",
        "region_id",
        "base_effort_units",
        "scenario_effort_units",
        "changed_field",
        "multiplier",
        "rounding"
      ],
      "title": "ScenarioEffortChangeV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "advanced_policy_confirmation_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Advanced Policy Confirmation Id",
      "type": "string"
    },
    "base_cells": {
      "items": {
        "$ref": "#/$defs/CapacityCellV2"
      },
      "title": "Base Cells",
      "type": "array"
    },
    "changes": {
      "items": {
        "$ref": "#/$defs/ScenarioEffortChangeV2"
      },
      "title": "Changes",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "label": {
      "const": "USER_SELECTED_ASSUMPTION_NOT_A_FORECAST",
      "title": "Label",
      "type": "string"
    },
    "mapping_profile_sha256s": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Mapping Profile Sha256S",
      "type": "array"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "scenario_cells": {
      "items": {
        "$ref": "#/$defs/CapacityCellV2"
      },
      "title": "Scenario Cells",
      "type": "array"
    },
    "scenario_comparison_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Scenario Comparison Id",
      "type": "string"
    },
    "scenario_id": {
      "const": "EMEA_EFFORT_PLUS_25_PERCENT",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "orchestrator.scenario-comparison.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_manifest_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Manifest Ids",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "policy_sha256",
    "source_manifest_ids",
    "mapping_profile_sha256s",
    "schema_version",
    "scenario_comparison_id",
    "scenario_id",
    "label",
    "advanced_policy_confirmation_id",
    "changes",
    "base_cells",
    "scenario_cells",
    "created_at"
  ],
  "title": "ScenarioComparisonV2",
  "type": "object"
}
