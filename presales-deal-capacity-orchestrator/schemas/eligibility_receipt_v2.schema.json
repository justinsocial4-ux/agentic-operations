{
  "$defs": {
    "EligibilityCheckV2": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "enum": [
            "DEAL_LANE",
            "ACTIVE_STATUS",
            "REGION",
            "SKILLS",
            "LANGUAGE",
            "TIME_ZONE",
            "WORKING_WINDOW",
            "CAPACITY_COMPLETE",
            "CUMULATIVE_CAPACITY",
            "UTILIZATION",
            "FROZEN_RECEIPTS"
          ],
          "title": "Check Id",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "reason_code": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        }
      },
      "required": [
        "check_id",
        "passed"
      ],
      "title": "EligibilityCheckV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actual_working_window_minutes": {
      "maximum": 1440,
      "minimum": 0,
      "title": "Actual Working Window Minutes",
      "type": "integer"
    },
    "capacity_receipt_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Capacity Receipt Id",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/EligibilityCheckV2"
      },
      "title": "Checks",
      "type": "array"
    },
    "consultant_source_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Consultant Source Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deal_source_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Deal Source Id",
      "type": "string"
    },
    "due_week_bucket": {
      "enum": [
        1,
        2,
        3,
        4
      ],
      "title": "Due Week Bucket",
      "type": "integer"
    },
    "eligibility_receipt_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Eligibility Receipt Id",
      "type": "string"
    },
    "eligible": {
      "title": "Eligible",
      "type": "boolean"
    },
    "mapping_profile_sha256s": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Mapping Profile Sha256S",
      "type": "array"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "priority_receipt_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Priority Receipt Id",
      "type": "string"
    },
    "projected_utilization_bp": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Projected Utilization Bp"
    },
    "reason_codes": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "orchestrator.eligibility-receipt.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_manifest_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Manifest Ids",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "policy_sha256",
    "source_manifest_ids",
    "mapping_profile_sha256s",
    "schema_version",
    "eligibility_receipt_id",
    "deal_source_id",
    "consultant_source_id",
    "priority_receipt_id",
    "capacity_receipt_id",
    "due_week_bucket",
    "checks",
    "eligible",
    "reason_codes",
    "actual_working_window_minutes",
    "created_at"
  ],
  "title": "EligibilityReceiptV2",
  "type": "object"
}
