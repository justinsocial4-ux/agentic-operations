{
  "additionalProperties": false,
  "properties": {
    "capacity_cell_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Capacity Cell Id",
      "type": "string"
    },
    "committed_workload_units": {
      "minimum": 0,
      "title": "Committed Workload Units",
      "type": "integer"
    },
    "demand_units": {
      "minimum": 0,
      "title": "Demand Units",
      "type": "integer"
    },
    "eligible_supply_units": {
      "minimum": 0,
      "title": "Eligible Supply Units",
      "type": "integer"
    },
    "excluded_incomplete_consultant_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
        "type": "string"
      },
      "title": "Excluded Incomplete Consultant Ids",
      "type": "array"
    },
    "free_units": {
      "minimum": 0,
      "title": "Free Units",
      "type": "integer"
    },
    "mapping_profile_sha256s": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Mapping Profile Sha256S",
      "type": "array"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "projected_utilization_bp": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Projected Utilization Bp"
    },
    "region_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Region Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "orchestrator.capacity-cell.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "skill_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Skill Id",
      "type": "string"
    },
    "skill_rows_additive": {
      "const": false,
      "title": "Skill Rows Additive",
      "type": "boolean"
    },
    "source_manifest_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Manifest Ids",
      "type": "array"
    },
    "supply_state": {
      "enum": [
        "COMPLETE",
        "PARTIAL_SUPPLY_EXCLUDED"
      ],
      "title": "Supply State",
      "type": "string"
    },
    "surplus_deficit_units": {
      "title": "Surplus Deficit Units",
      "type": "integer"
    },
    "week_bucket": {
      "enum": [
        1,
        2,
        3,
        4
      ],
      "title": "Week Bucket",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "policy_sha256",
    "source_manifest_ids",
    "mapping_profile_sha256s",
    "schema_version",
    "capacity_cell_id",
    "region_id",
    "skill_id",
    "week_bucket",
    "demand_units",
    "eligible_supply_units",
    "committed_workload_units",
    "free_units",
    "surplus_deficit_units",
    "excluded_incomplete_consultant_ids",
    "supply_state",
    "skill_rows_additive"
  ],
  "title": "CapacityCellV2",
  "type": "object"
}
