{
  "$defs": {
    "LaneV1": {
      "enum": [
        "DEAL_PRIORITIZATION",
        "ASSIGNMENT_RECOMMENDATION",
        "CAPACITY_HEATMAP"
      ],
      "title": "LaneV1",
      "type": "string"
    },
    "PopulationCountsV1": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "minimum": 0,
          "title": "Accepted",
          "type": "integer"
        },
        "declared": {
          "minimum": 0,
          "title": "Declared",
          "type": "integer"
        },
        "duplicate": {
          "minimum": 0,
          "title": "Duplicate",
          "type": "integer"
        },
        "excluded": {
          "minimum": 0,
          "title": "Excluded",
          "type": "integer"
        },
        "fetched": {
          "minimum": 0,
          "title": "Fetched",
          "type": "integer"
        },
        "parsed": {
          "minimum": 0,
          "title": "Parsed",
          "type": "integer"
        },
        "population": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Population",
          "type": "string"
        },
        "quarantined": {
          "minimum": 0,
          "title": "Quarantined",
          "type": "integer"
        },
        "read_complete": {
          "title": "Read Complete",
          "type": "boolean"
        },
        "tombstoned": {
          "minimum": 0,
          "title": "Tombstoned",
          "type": "integer"
        },
        "unmatched": {
          "minimum": 0,
          "title": "Unmatched",
          "type": "integer"
        }
      },
      "required": [
        "population",
        "declared",
        "fetched",
        "parsed",
        "accepted",
        "quarantined",
        "excluded",
        "duplicate",
        "tombstoned",
        "unmatched",
        "read_complete"
      ],
      "title": "PopulationCountsV1",
      "type": "object"
    },
    "SourceConflictV1": {
      "additionalProperties": false,
      "properties": {
        "acknowledged": {
          "title": "Acknowledged",
          "type": "boolean"
        },
        "canonical_field_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Canonical Field Id",
          "type": "string"
        },
        "canonical_record_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
          "title": "Canonical Record Id",
          "type": "string"
        },
        "losing_source_manifest_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Losing Source Manifest Ids",
          "type": "array"
        },
        "winning_source_manifest_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
          "title": "Winning Source Manifest Id",
          "type": "string"
        }
      },
      "required": [
        "canonical_record_id",
        "canonical_field_id",
        "winning_source_manifest_id",
        "losing_source_manifest_ids",
        "acknowledged"
      ],
      "title": "SourceConflictV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accepted_for_operational_commit": {
      "title": "Accepted For Operational Commit",
      "type": "boolean"
    },
    "capped_source_manifest_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
        "type": "string"
      },
      "title": "Capped Source Manifest Ids",
      "type": "array"
    },
    "conversation_conflict_count": {
      "minimum": 0,
      "title": "Conversation Conflict Count",
      "type": "integer"
    },
    "conversation_duplicate_count": {
      "minimum": 0,
      "title": "Conversation Duplicate Count",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "incomplete_consultant_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
        "type": "string"
      },
      "title": "Incomplete Consultant Ids",
      "type": "array"
    },
    "lane": {
      "$ref": "#/$defs/LaneV1"
    },
    "mapping_profile_sha256s": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Mapping Profile Sha256S",
      "type": "array"
    },
    "missing_required_populations": {
      "items": {
        "type": "string"
      },
      "title": "Missing Required Populations",
      "type": "array"
    },
    "orphan_reference_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
        "type": "string"
      },
      "title": "Orphan Reference Ids",
      "type": "array"
    },
    "populations": {
      "items": {
        "$ref": "#/$defs/PopulationCountsV1"
      },
      "minItems": 1,
      "title": "Populations",
      "type": "array"
    },
    "receipt_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Receipt Id",
      "type": "string"
    },
    "reconciliation_equation": {
      "const": "parsed = accepted + quarantined + excluded + duplicate",
      "title": "Reconciliation Equation",
      "type": "string"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "orchestrator.data-health-receipt.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_conflicts": {
      "items": {
        "$ref": "#/$defs/SourceConflictV1"
      },
      "title": "Source Conflicts",
      "type": "array"
    },
    "source_manifest_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Manifest Ids",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "receipt_id",
    "run_id",
    "lane",
    "source_manifest_ids",
    "mapping_profile_sha256s",
    "populations",
    "missing_required_populations",
    "orphan_reference_ids",
    "incomplete_consultant_ids",
    "source_conflicts",
    "conversation_duplicate_count",
    "conversation_conflict_count",
    "capped_source_manifest_ids",
    "reconciliation_equation",
    "accepted_for_operational_commit",
    "created_at"
  ],
  "title": "DataHealthReceiptV1",
  "type": "object"
}
