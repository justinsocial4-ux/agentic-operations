{
  "$defs": {
    "AnalystCitationV2": {
      "additionalProperties": false,
      "properties": {
        "char_begin": {
          "minimum": 0,
          "title": "Char Begin",
          "type": "integer"
        },
        "char_end": {
          "minimum": 0,
          "title": "Char End",
          "type": "integer"
        },
        "conversation_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
          "title": "Conversation Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "relative_begin_ms": {
          "minimum": 0,
          "title": "Relative Begin Ms",
          "type": "integer"
        },
        "segment_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
          "title": "Segment Id",
          "type": "string"
        },
        "text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Text Sha256",
          "type": "string"
        }
      },
      "required": [
        "conversation_id",
        "segment_id",
        "quote",
        "char_begin",
        "char_end",
        "text_sha256",
        "relative_begin_ms"
      ],
      "title": "AnalystCitationV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_mode": {
      "enum": [
        "LIVE_LOCAL",
        "RECORDED_ANALYST_REPLAY",
        "MANUAL_CITATION"
      ],
      "title": "Analysis Mode",
      "type": "string"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/AnalystCitationV2"
      },
      "title": "Citations",
      "type": "array"
    },
    "deal_source_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Deal Source Id",
      "type": "string"
    },
    "dimension_id": {
      "enum": [
        "business-problem",
        "buyer-outcome",
        "technical-scope",
        "stakeholder-role-coverage",
        "success-criteria",
        "security-or-data-requirements",
        "evaluation-plan",
        "customer-owner-and-next-step",
        "milestone-date"
      ],
      "title": "Dimension Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:%/@+-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "orchestrator.analyst-observation.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "enum": [
        "SUPPORTED",
        "UNKNOWN",
        "CONFLICT"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "analysis_mode",
    "input_sha256",
    "deal_source_id",
    "dimension_id",
    "state",
    "citations"
  ],
  "title": "AnalystObservationV2",
  "type": "object"
}
